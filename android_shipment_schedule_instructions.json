{
  "feature_name": "Shipment Schedule Management",
  "version": "1.0",
  "description": "Complete implementation guide for Shipment Schedule feature in Android app with multi-vendor support",
  "base_url": "https://your-domain.com/api/v1",
  
  "authentication": {
    "updated_login_api": {
      "endpoint": "/auth/login",
      "method": "POST",
      "description": "Login endpoint now includes vendor information in response",
      "request": {
        "headers": {
          "Content-Type": "application/json",
          "Accept": "application/json"
        },
        "body": {
          "email": "user@example.com",
          "password": "password123"
        }
      },
      "response_success": {
        "success": true,
        "message": "Login successful",
        "data": {
          "user": {
            "id": 1,
            "name": "John Doe",
            "email": "user@example.com",
            "phone": "+1234567890",
            "role": "manager",
            "avis_id": null,
            "avatar": null,
            "avatar_url": null,
            "email_verified_at": "2024-01-01T08:00:00.000000Z",
            "created_at": "2024-01-01T08:00:00.000000Z",
            "updated_at": "2024-01-01T08:00:00.000000Z"
          },
          "vendor": {
            "id": 1,
            "name": "ABC Company",
            "email": "contact@abccompany.com",
            "phone": "+1234567890",
            "address": "123 Main St",
            "city": "New York",
            "state": "NY",
            "country": "USA",
            "zip": "10001",
            "website": "https://abccompany.com",
            "status": "active",
            "created_at": "2024-01-01T08:00:00.000000Z",
            "updated_at": "2024-01-01T08:00:00.000000Z"
          },
          "token": "2|xyz789..."
        }
      },
      "response_error": {
        "success": false,
        "message": "Invalid credentials",
        "data": []
      },
      "notes": [
        "The 'vendor' field will be null for admin users who don't belong to a specific vendor",
        "Store the vendor information in SharedPreferences or your app's local storage",
        "Display vendor name in the app header/navigation drawer",
        "Use the token in Authorization header for all subsequent API calls: 'Bearer {token}'"
      ]
    },
    "me_endpoint": {
      "endpoint": "/auth/me",
      "method": "GET",
      "description": "Get current authenticated user with vendor information",
      "headers": {
        "Authorization": "Bearer {token}",
        "Accept": "application/json"
      },
      "response": {
        "success": true,
        "message": "User retrieved successfully",
        "data": {
          "user": { "same_structure_as_login" },
          "vendor": { "same_structure_as_login" }
        }
      }
    }
  },

  "data_models": {
    "schedule": {
      "id": "integer",
      "vessel_name": "string (required, max:255)",
      "voyage_no": "string (required, max:255)",
      "carrier_1": {
        "id": "integer",
        "line_name": "string"
      },
      "carrier_2": {
        "id": "integer",
        "line_name": "string"
      },
      "carrier_3": {
        "id": "integer",
        "line_name": "string"
      },
      "start_port": {
        "id": "integer",
        "port_name": "string",
        "port_type": "string (Local Port/Overseas Port)",
        "port_address": "string"
      },
      "end_port": {
        "id": "integer",
        "port_name": "string",
        "port_type": "string",
        "port_address": "string"
      },
      "eta": "string (date format: YYYY-MM-DD)",
      "status": "string (Waiting/In Transit/Arrived/Completed/Cancelled)",
      "comment": "string (nullable)",
      "stopovers": "array of stopover objects",
      "added_by": {
        "id": "integer",
        "name": "string",
        "email": "string"
      },
      "created_at": "string (ISO 8601)",
      "updated_at": "string (ISO 8601)"
    },
    "stopover": {
      "id": "integer",
      "schedule_id": "integer",
      "port": {
        "id": "integer",
        "port_name": "string",
        "port_type": "string",
        "port_address": "string"
      },
      "stopover_eta": "string (ISO 8601 datetime, nullable)",
      "stopover_etd": "string (ISO 8601 datetime, nullable)",
      "status": "string (Waiting/In Transit/Arrived/Completed/Cancelled)",
      "added_by": {
        "id": "integer",
        "name": "string",
        "email": "string"
      },
      "created_at": "string (ISO 8601)",
      "updated_at": "string (ISO 8601)"
    },
    "port": {
      "id": "integer",
      "port_name": "string",
      "port_type": "string (Local Port/Overseas Port)",
      "port_address": "string",
      "created_at": "string (ISO 8601)",
      "updated_at": "string (ISO 8601)"
    },
    "shipping_company": {
      "id": "integer",
      "line_name": "string",
      "status": "string (Active/Inactive)"
    }
  },

  "api_endpoints": {
    "schedules": {
      "list": {
        "endpoint": "/schedules",
        "method": "GET",
        "description": "Get paginated list of schedules with optional filters",
        "headers": {
          "Authorization": "Bearer {token}",
          "Accept": "application/json"
        },
        "query_parameters": {
          "search": "string (optional) - Search in vessel_name and voyage_no",
          "vessel_name": "string (optional) - Filter by vessel name",
          "voyage_no": "string (optional) - Filter by voyage number",
          "carrier_id": "integer (optional) - Filter by carrier ID",
          "start_port_id": "integer (optional) - Filter by start port ID",
          "end_port_id": "integer (optional) - Filter by end port ID",
          "per_page": "integer (optional, default: 15) - Items per page",
          "page": "integer (optional, default: 1) - Page number"
        },
        "response": {
          "success": true,
          "message": "Schedules retrieved successfully",
          "data": {
            "schedules": [
              {
                "id": 1,
                "vessel_name": "MV Ocean Star",
                "voyage_no": "VOY-2024-001",
                "carrier_1": {
                  "id": 1,
                  "line_name": "Maersk Line"
                },
                "carrier_2": null,
                "carrier_3": null,
                "start_port": {
                  "id": 1,
                  "port_name": "Port of Los Angeles",
                  "port_type": "Local Port",
                  "port_address": "Los Angeles, CA"
                },
                "end_port": {
                  "id": 2,
                  "port_name": "Port of New York",
                  "port_type": "Local Port",
                  "port_address": "New York, NY"
                },
                "eta": "2024-02-15",
                "status": "Waiting",
                "comment": "First voyage of the year",
                "stopovers": [
                  {
                    "id": 1,
                    "schedule_id": 1,
                    "port": {
                      "id": 3,
                      "port_name": "Port of Miami",
                      "port_type": "Local Port",
                      "port_address": "Miami, FL"
                    },
                    "stopover_eta": "2024-02-10T08:00:00.000000Z",
                    "stopover_etd": "2024-02-12T18:00:00.000000Z",
                    "status": "Waiting",
                    "added_by": {
                      "id": 1,
                      "name": "John Doe",
                      "email": "john@example.com"
                    },
                    "created_at": "2024-01-15T10:00:00.000000Z",
                    "updated_at": "2024-01-15T10:00:00.000000Z"
                  }
                ],
                "added_by": {
                  "id": 1,
                  "name": "John Doe",
                  "email": "john@example.com"
                },
                "created_at": "2024-01-15T10:00:00.000000Z",
                "updated_at": "2024-01-15T10:00:00.000000Z"
              }
            ],
            "pagination": {
              "current_page": 1,
              "last_page": 5,
              "per_page": 15,
              "total": 67
            }
          }
        }
      },
      "create": {
        "endpoint": "/schedules",
        "method": "POST",
        "description": "Create a new shipment schedule",
        "headers": {
          "Authorization": "Bearer {token}",
          "Content-Type": "application/json",
          "Accept": "application/json"
        },
        "request_body": {
          "vessel_name": "MV Ocean Star",
          "voyage_no": "VOY-2024-001",
          "carrier_1_id": 1,
          "carrier_2_id": null,
          "carrier_3_id": null,
          "start_port_id": 1,
          "end_port_id": 2,
          "eta": "2024-02-15",
          "status": "Waiting",
          "comment": "First voyage of the year"
        },
        "validation_rules": {
          "vessel_name": "required|string|max:255",
          "voyage_no": "required|string|max:255",
          "carrier_1_id": "nullable|integer|exists in shipping_companies",
          "carrier_2_id": "nullable|integer|exists in shipping_companies",
          "carrier_3_id": "nullable|integer|exists in shipping_companies",
          "start_port_id": "required|integer|exists in ports",
          "end_port_id": "required|integer|exists in ports",
          "eta": "required|date (YYYY-MM-DD)",
          "status": "optional|string|in:Waiting,In Transit,Arrived,Completed,Cancelled",
          "comment": "nullable|string"
        },
        "response_success": {
          "success": true,
          "message": "Schedule created successfully",
          "data": {
            "schedule": { "same_structure_as_list_response" }
          }
        },
        "response_error": {
          "success": false,
          "message": "Validation failed",
          "data": {
            "vessel_name": ["Vessel name is required."],
            "start_port_id": ["Start port is required."]
          }
        }
      },
      "show": {
        "endpoint": "/schedules/{schedule_id}",
        "method": "GET",
        "description": "Get a single schedule with all relationships loaded",
        "headers": {
          "Authorization": "Bearer {token}",
          "Accept": "application/json"
        },
        "response": {
          "success": true,
          "message": "Schedule retrieved successfully",
          "data": {
            "schedule": { "same_structure_as_list_response" }
          }
        }
      },
      "update": {
        "endpoint": "/schedules/{schedule_id}",
        "method": "PUT",
        "description": "Update an existing schedule",
        "headers": {
          "Authorization": "Bearer {token}",
          "Content-Type": "application/json",
          "Accept": "application/json"
        },
        "request_body": {
          "vessel_name": "MV Ocean Star Updated",
          "voyage_no": "VOY-2024-001",
          "carrier_1_id": 1,
          "start_port_id": 1,
          "end_port_id": 2,
          "eta": "2024-02-20",
          "status": "In Transit",
          "comment": "Updated comment"
        },
        "validation_rules": {
          "all_fields_are_optional_but_must_be_valid_if_provided": "same_as_create_validation"
        },
        "response": {
          "success": true,
          "message": "Schedule updated successfully",
          "data": {
            "schedule": { "same_structure_as_list_response" }
          }
        }
      },
      "delete": {
        "endpoint": "/schedules/{schedule_id}",
        "method": "DELETE",
        "description": "Delete a schedule (only admin and manager roles)",
        "headers": {
          "Authorization": "Bearer {token}",
          "Accept": "application/json"
        },
        "response_success": {
          "success": true,
          "message": "Schedule deleted successfully",
          "data": []
        },
        "response_error_unauthorized": {
          "success": false,
          "message": "Unauthorized. Only admin or manager can delete schedules.",
          "data": []
        }
      }
    },
    "stopovers": {
      "create": {
        "endpoint": "/schedules/{schedule_id}/stopovers",
        "method": "POST",
        "description": "Create a new stopover for a schedule",
        "headers": {
          "Authorization": "Bearer {token}",
          "Content-Type": "application/json",
          "Accept": "application/json"
        },
        "request_body": {
          "port_id": 3,
          "stopover_eta": "2024-02-10",
          "stopover_etd": "2024-02-12",
          "status": "Waiting"
        },
        "validation_rules": {
          "port_id": "required|integer|exists in ports",
          "stopover_eta": "nullable|date (YYYY-MM-DD)",
          "stopover_etd": "nullable|date (YYYY-MM-DD, must be >= stopover_eta)",
          "status": "optional|string|in:Waiting,In Transit,Arrived,Completed,Cancelled"
        },
        "response": {
          "success": true,
          "message": "Stopover created successfully",
          "data": {
            "stopover": { "same_structure_as_stopover_model" }
          }
        }
      },
      "show": {
        "endpoint": "/stopovers/{stopover_id}",
        "method": "GET",
        "description": "Get a single stopover",
        "headers": {
          "Authorization": "Bearer {token}",
          "Accept": "application/json"
        },
        "response": {
          "success": true,
          "message": "Stopover retrieved successfully",
          "data": {
            "stopover": { "same_structure_as_stopover_model" }
          }
        }
      },
      "update": {
        "endpoint": "/stopovers/{stopover_id}",
        "method": "PUT",
        "description": "Update an existing stopover",
        "headers": {
          "Authorization": "Bearer {token}",
          "Content-Type": "application/json",
          "Accept": "application/json"
        },
        "request_body": {
          "port_id": 3,
          "stopover_eta": "2024-02-11",
          "stopover_etd": "2024-02-13",
          "status": "In Transit"
        },
        "response": {
          "success": true,
          "message": "Stopover updated successfully",
          "data": {
            "stopover": { "same_structure_as_stopover_model" }
          }
        }
      },
      "delete": {
        "endpoint": "/stopovers/{stopover_id}",
        "method": "DELETE",
        "description": "Delete a stopover (only admin and manager roles)",
        "headers": {
          "Authorization": "Bearer {token}",
          "Accept": "application/json"
        },
        "response": {
          "success": true,
          "message": "Stopover deleted successfully",
          "data": []
        }
      }
    },
    "ports": {
      "list": {
        "endpoint": "/ports",
        "method": "GET",
        "description": "Get list of ports for dropdowns (read-only, no CRUD needed)",
        "headers": {
          "Authorization": "Bearer {token}",
          "Accept": "application/json"
        },
        "query_parameters": {
          "search": "string (optional) - Search in port_name and port_address",
          "port_type": "string (optional) - Filter by port_type (Local Port/Overseas Port)",
          "per_page": "integer (optional, default: 15) - For pagination, or use large number to get all",
          "page": "integer (optional, default: 1)"
        },
        "response": {
          "success": true,
          "message": "Ports retrieved successfully",
          "data": {
            "ports": [
              {
                "id": 1,
                "port_name": "Port of Los Angeles",
                "port_type": "Local Port",
                "port_address": "Los Angeles, CA",
                "created_at": "2024-01-01T08:00:00.000000Z",
                "updated_at": "2024-01-01T08:00:00.000000Z"
              }
            ],
            "pagination": {
              "current_page": 1,
              "last_page": 1,
              "per_page": 15,
              "total": 10
            }
          }
        },
        "usage_notes": [
          "Use this endpoint to populate dropdowns for Start Port, End Port, and Stopover Port selection",
          "For Start Port and End Port dropdowns, filter by port_type='Local Port'",
          "For Stopover Port dropdowns, include both 'Local Port' and 'Overseas Port'",
          "Cache the port list locally to reduce API calls"
        ]
      }
    },
    "shipping_companies": {
      "list": {
        "endpoint": "/shipping-companies",
        "method": "GET",
        "description": "Get list of shipping companies/carriers for dropdowns (read-only, no CRUD needed)",
        "headers": {
          "Authorization": "Bearer {token}",
          "Accept": "application/json"
        },
        "query_parameters": {
          "search": "string (optional) - Search in line_name",
          "status": "string (optional) - Filter by status (Active/Inactive), use 'Active' for dropdowns",
          "per_page": "integer (optional, default: 15) - Use large number to get all active carriers",
          "page": "integer (optional, default: 1)"
        },
        "response": {
          "success": true,
          "message": "Shipping companies retrieved successfully",
          "data": {
            "shipping_companies": [
              {
                "id": 1,
                "line_name": "Maersk Line",
                "status": "Active"
              }
            ],
            "pagination": {
              "current_page": 1,
              "last_page": 1,
              "per_page": 15,
              "total": 5
            }
          }
        },
        "usage_notes": [
          "Use this endpoint to populate Carrier 1, Carrier 2, Carrier 3 dropdowns",
          "Filter by status='Active' to show only active carriers",
          "Cache the shipping companies list locally to reduce API calls"
        ]
      }
    }
  },

  "ui_flow": {
    "navigation": {
      "menu_item": {
        "title": "Shipment Schedule",
        "icon": "ship/calendar icon",
        "location": "Side drawer menu",
        "order": "After existing menu items"
      }
    },
    "screens": {
      "schedule_list_screen": {
        "name": "ScheduleListActivity/Fragment",
        "description": "Main screen displaying list of schedules",
        "components": [
          {
            "type": "Toolbar",
            "content": "Shipment Schedules",
            "actions": [
              {
                "icon": "search",
                "action": "Open search/filter dialog"
              },
              {
                "icon": "add/fab",
                "action": "Navigate to CreateScheduleScreen",
                "visibility": "Always visible"
              }
            ]
          },
          {
            "type": "SearchBar",
            "placeholder": "Search by vessel name or voyage number",
            "action": "Call API with search parameter"
          },
          {
            "type": "FilterChips",
            "filters": [
              "By Carrier",
              "By Start Port",
              "By End Port",
              "By Status"
            ],
            "action": "Open filter bottom sheet/dialog"
          },
          {
            "type": "RecyclerView/ListView",
            "item_layout": "schedule_item_card.xml",
            "item_fields": [
              "Vessel Name (bold, large)",
              "Voyage No (medium)",
              "Start Port → End Port (with arrow icon)",
              "ETA (formatted date)",
              "Status (colored badge/chip)",
              "Carrier 1 name (if available)",
              "Stopover count badge (if > 0)"
            ],
            "click_action": "Navigate to ScheduleDetailScreen",
            "long_press_action": "Show context menu (Edit/Delete)",
            "swipe_action": "Delete (if user is admin/manager)"
          },
          {
            "type": "Pagination",
            "implementation": "Load more on scroll or pagination controls",
            "api_parameter": "page"
          },
          {
            "type": "EmptyState",
            "message": "No schedules found",
            "icon": "empty calendar icon",
            "action_button": "Create First Schedule"
          }
        ],
        "api_calls": [
          "GET /schedules with filters and pagination",
          "GET /ports (for filter dropdowns)",
          "GET /shipping-companies (for filter dropdowns)"
        ]
      },
      "schedule_detail_screen": {
        "name": "ScheduleDetailActivity/Fragment",
        "description": "Display full schedule details with expandable stopovers",
        "components": [
          {
            "type": "Toolbar",
            "content": "Schedule Details",
            "actions": [
              {
                "icon": "edit",
                "action": "Navigate to EditScheduleScreen",
                "visibility": "Always visible"
              },
              {
                "icon": "delete",
                "action": "Show delete confirmation dialog",
                "visibility": "Only for admin/manager"
              }
            ]
          },
          {
            "type": "ScrollView",
            "sections": [
              {
                "section_title": "Basic Information",
                "fields": [
                  "Vessel Name",
                  "Voyage No",
                  "Start Port (with port type badge)",
                  "End Port (with port type badge)",
                  "ETA (formatted)",
                  "Status (colored badge)",
                  "Comment (if available)"
                ]
              },
              {
                "section_title": "Carriers",
                "fields": [
                  "Carrier 1 (if available)",
                  "Carrier 2 (if available)",
                  "Carrier 3 (if available)"
                ],
                "layout": "Horizontal chips or list"
              },
              {
                "section_title": "Stopovers",
                "type": "ExpandableSection",
                "header": "Stopovers (count)",
                "expandable_content": {
                  "type": "RecyclerView",
                  "item_layout": "stopover_item.xml",
                  "item_fields": [
                    "Port Name (with port type)",
                    "Arrival (ETA) - formatted date",
                    "Departure (ETD) - formatted date",
                    "Status badge"
                  ],
                  "click_action": "Navigate to EditStopoverScreen",
                  "long_press_action": "Delete stopover (if admin/manager)"
                },
                "add_button": {
                  "text": "Add Stopover",
                  "action": "Navigate to CreateStopoverScreen with schedule_id"
                }
              },
              {
                "section_title": "Metadata",
                "fields": [
                  "Added By (user name)",
                  "Created At (formatted)",
                  "Updated At (formatted)"
                ],
                "style": "Small text, gray color"
              }
            ]
          }
        ],
        "api_calls": [
          "GET /schedules/{schedule_id} (with all relationships)"
        ]
      },
      "create_schedule_screen": {
        "name": "CreateScheduleActivity/Fragment",
        "description": "Form to create a new schedule",
        "components": [
          {
            "type": "Toolbar",
            "content": "Create Schedule",
            "actions": [
              {
                "icon": "close/cancel",
                "action": "Close/Dismiss"
              }
            ]
          },
          {
            "type": "Form",
            "fields": [
              {
                "name": "vessel_name",
                "type": "TextInput",
                "label": "Vessel Name",
                "hint": "Enter vessel name",
                "required": true,
                "validation": "Required, max 255 characters"
              },
              {
                "name": "voyage_no",
                "type": "TextInput",
                "label": "Voyage No",
                "hint": "Enter voyage number",
                "required": true,
                "validation": "Required, max 255 characters"
              },
              {
                "name": "carrier_1_id",
                "type": "Spinner/Dropdown",
                "label": "Carrier 1",
                "required": false,
                "data_source": "GET /shipping-companies?status=Active",
                "display_field": "line_name",
                "value_field": "id"
              },
              {
                "name": "carrier_2_id",
                "type": "Spinner/Dropdown",
                "label": "Carrier 2 (Optional)",
                "required": false,
                "data_source": "GET /shipping-companies?status=Active",
                "display_field": "line_name",
                "value_field": "id",
                "note": "Can be disabled/hidden if not needed"
              },
              {
                "name": "carrier_3_id",
                "type": "Spinner/Dropdown",
                "label": "Carrier 3 (Optional)",
                "required": false,
                "data_source": "GET /shipping-companies?status=Active",
                "display_field": "line_name",
                "value_field": "id",
                "note": "Can be disabled/hidden if not needed"
              },
              {
                "name": "start_port_id",
                "type": "Spinner/Dropdown",
                "label": "Start Port",
                "required": true,
                "data_source": "GET /ports?port_type=Local Port",
                "display_field": "port_name",
                "value_field": "id",
                "searchable": true
              },
              {
                "name": "end_port_id",
                "type": "Spinner/Dropdown",
                "label": "End Port",
                "required": true,
                "data_source": "GET /ports?port_type=Local Port",
                "display_field": "port_name",
                "value_field": "id",
                "searchable": true
              },
              {
                "name": "eta",
                "type": "DatePicker",
                "label": "ETA (Estimated Time of Arrival)",
                "required": true,
                "validation": "Required, valid date"
              },
              {
                "name": "status",
                "type": "Spinner/Dropdown",
                "label": "Status",
                "required": false,
                "options": [
                  "Waiting",
                  "In Transit",
                  "Arrived",
                  "Completed",
                  "Cancelled"
                ],
                "default": "Waiting"
              },
              {
                "name": "comment",
                "type": "MultiLineTextInput",
                "label": "Comment",
